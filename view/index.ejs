<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Links</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-giJF6kkoqNQ00vy+HMDP7azOuL0xtbfIcaT9wjKHr8RbDVddVHyTfAAsrekwKmP1" crossorigin="anonymous">
    <link rel="stylesheet" href="/fontawesome-free-5.15.2-web/css/all.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"
        defer></script>

    <style>
        .list a {
            cursor: pointer;
            text-decoration: none;
            color: black;
        }
    </style>
</head>

<body style="background-color: rgb(51, 51, 51);">
    <div class="container rounded-3 border border-5 border-dark my-5 bg-white" style="height:auto;">
        <div>
            <h1 class="h1" data-bs-toggle="modal" data-bs-target="#exampleModal">Links </></h1>
            <%if(session=='treehouse' ){%>
                <button class="btn btn-dark"><a href="/logout"
                        style="text-decoration: none; color: white;">Logout</a></button>
                <%}%>
                    <div>
                        <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel"
                            aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Login</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <form action="/login" method="post">
                                            <input type="text" name="name">
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary"
                                            data-bs-dismiss="modal">Login</button>
                                    </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <form action="/add" method="post" class="row">
                        <div class="col-md-8 row g-2">
                            <div class="col-md-4">
                                <input class="py-3 form-control shadow" name="name" placeholder="Name" type="text"
                                    required>
                            </div>
                            <div class="col-md-4">
                                <input class="py-3 form-control shadow" name="link" placeholder="Link" type="text"
                                    required>
                            </div>
                            <div class="col-md-4">
                                <input class="py-3 form-control shadow" name="desc" placeholder="Description *optional"
                                    type="text">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <%if(session){%>
                                <button type="submit" class="mt-2 btn btn-dark">Add</button>
                                <% } else { %>
                                    <button type="submit" class="mt-2 btn btn-dark" disabled>Add</button>
                                    <%}%>
                        </div>
                    </form>
        </div>
        <hr>
        <div class="row rounded bg-white">
            <ul class="row list-unstyled" id="list">
                <% result.forEach(ite=> { %>
                    <li class="col-12 col-md-6 col-lg-6 my-3 py-3 shadow list-group-item border">
                        <div class="p-3 bg-light rounded">
                            <div>
                                <span class="h4">
                                    <%= ite.name %>
                                </span>
                                <p class="h6">
                                    <%= ite.desc %>
                                </p>
                            </div>
                            <div class="d-flex gap-3">
                                <a href="/" data-bs-toggle="modal"
                                    data-bs-target="#exampleModal_<%= ite._id %>">Edit</a>
                                <div class="modal fade" id="exampleModal_<%= ite._id %>" tabindex="-1"
                                    aria-labelledby="exampleModalLabel_<%= ite._id %>" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h1 class="modal-title fs-5" id="exampleModalLabel_<%= ite._id %>">
                                                    Update</h1>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <form action="/update/<%= ite._id %>" method="post" class="row">
                                                    <div class="col-md-12 row g-2">
                                                        <div class="col-md-6">
                                                            <input class="py-3 form-control shadow" name="name"
                                                                value="<%= ite.name %>" id="a_<%= ite._id %>"
                                                                placeholder="Name" type="text" required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <input class="py-3 form-control shadow" name="link"
                                                                value="<%= ite.link %>" id="b_<%= ite._id %>"
                                                                placeholder="Link" type="text" required>
                                                        </div>
                                                        <div class="col-md-12">
                                                            <input class="py-3 form-control shadow" name="desc"
                                                                value="<%= ite.desc %>" id="c_<%= ite._id %>"
                                                                placeholder="Description *optional" type="text">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <button type="button" class="mt-2 btn btn-dark"
                                                            onclick="clearFields('<%= ite._id %>')">Clear</button>
                                                    </div>
                                            </div>
                                            <div class="modal-footer">
                                                <%if(session){%>
                                                    <button type="submit" class="btn btn-primary"
                                                        data-bs-dismiss="modal">Update</button>
                                                    <% } else { %>
                                                        <button class="btn btn-primary" disabled>Update</button>
                                                        <%}%>
                                            </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <a href="https://<%= ite.link %>">View</a>
                                <%if(session){%>
                                    <a href="/delete/<%= ite._id %>">Delete</a>
                                    <%}%>
                                        <%if(!session){%>
                                            <a href="/">Delete</a>
                                            <%}%>
                            </div>
                        </div>
                    </li>
                    <% }) %>
            </ul>
        </div>
    </div>
</body>

</html>
<script>
    const clearFields = (id) => {
        let inputName = document.getElementById(`a_${id}`);
        let inputLink = document.getElementById(`b_${id}`);
        let inputDesc = document.getElementById(`c_${id}`);

        if (inputName) inputName.value = '';
        if (inputLink) inputLink.value = '';
        if (inputDesc) inputDesc.value = '';
    };
</script>