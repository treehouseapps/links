<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Links</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-giJF6kkoqNQ00vy+HMDP7azOuL0xtbfIcaT9wjKHr8RbDVddVHyTfAAsrekwKmP1" crossorigin="anonymous">
    <link rel="stylesheet" href="/fontawesome-free-5.15.2-web/css/all.css">
    <style>
        .list a {
            cursor: pointer;
            text-decoration: none;
            color: black;
        }

        .imageholder {
            width: 12rem;
            height: 6rem;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .imageholder img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .divide {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
    </style>
</head>

<body style="background-color: rgb(51, 51, 51);">
    <div class="container rounded-3 border border-5 border-dark my-5 bg-white" style="height:auto;">
        <div>
            <h1 class="h1">Links</h1>
            <form action="/add" method="post" class="row" enctype="multipart/form-data">
                <div class="col-md-8 row g-2">
                    <div class="col-md-4">
                        <input class="py-3 form-control shadow" name="name" placeholder="Name" type="text" required>
                    </div>
                    <div class="col-md-4">
                        <input class="py-3 form-control shadow" name="link" placeholder="Link" type="text" required>
                    </div>
                    <div class="col-md-4">
                        <input class="py-3 form-control shadow" name="desc" placeholder="Description *optional"
                            type="text">
                    </div>
                    <div class="col-md-4">
                        <label for="imageUpload" class="form-label">Choose Image <span
                                class="text-muted">(Optional)</span></label>
                        <input class="form-control" type="file" id="image" name="image">
                    </div>

                </div>
                <div class="col-md-2">
                    <button type="submit" class="mt-2 btn btn-dark">Add</button>
                </div>
            </form>
        </div>
        <hr>
        <div class="row rounded bg-white">
            <ul class="row list-unstyled" id="list">
                <% result.forEach(ite=> { %>
                    <li class="col-12 col-md-6 col-lg-6 shadow list-group-item border">
                        <div class="p-3 bg-light rounded">
                            <div class="divide">
                                <div>
                                    <span class="h4">
                                        <%= ite.name %>
                                    </span>
                                    <p class="h6">
                                        <%= ite.desc %>
                                    </p>
                                    <div class="d-flex gap-3">
                                        <a href="/">Edit</a>
                                        <a href="https://<%= ite.link %>" target="_blank"
                                            rel="noopener noreferrer">View</a>
                                        <a href="delete/<%=ite._id%>">Delete</a>
                                    </div>
                                </div>
                                <div class="imageholder">
                                    <img src="../uploads/<%=ite.image%>" alt="img" srcset="">
                                </div>
                            </div>
                        </div>
                    </li>
                    <% }) %>
            </ul>
        </div>
    </div>
    <script src="script.js"></script>
</body>

</html>
